<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- neeche ka dark 3D edge -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="15dp" />
            <solid android:color="#1B1450" />
        </shape>
    </item>
    <!-- upar ka face (3dp upar utha hua) -->
    <item android:bottom="4dp">
        <shape android:shape="rectangle">
            <corners android:radius="15dp" />
            <gradient
                android:startColor="#8A6BFF"
                android:centerColor="#5C7CFF"
                android:endColor="#2AB8E6"
                android:angle="0" />
            <stroke android:width="1dp" android:color="#8FB6FF" />
        </shape>
    </item>
    <!-- upar ka highlight -->
    <item android:bottom="4dp">
        <shape android:shape="rectangle">
            <corners android:radius="15dp" />
            <gradient
                android:startColor="#33FFFFFF"
                android:endColor="#00FFFFFF"
                android:angle="90" />
        </shape>
    </item>
</layer-list>
