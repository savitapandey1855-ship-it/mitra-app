<resources>
    <style name="Theme.Mitra" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:statusBarColor">#150B36</item>
        <item name="android:navigationBarColor">#150B36</item>
        <item name="android:windowBackground">#150B36</item>
        <item name="colorPrimary">#6C4BFF</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorAccent">#22D3EE</item>
        <item name="android:textColorPrimary">#141B3D</item>
        <item name="alertDialogTheme">@style/BubluDialog</item>
        <item name="materialAlertDialogTheme">@style/BubluDialog</item>
    </style>

    <style name="BubluDialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="colorPrimary">#6C4BFF</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorSecondary">#22D3EE</item>
        <item name="android:textColorPrimary">#141B3D</item>
        <item name="android:textColorSecondary">#4A5578</item>
        <item name="android:windowBackground">@drawable/dialog_round</item>
        <item name="android:windowMinWidthMajor">88%</item>
        <item name="android:windowMinWidthMinor">92%</item>
    </style>
</resources>
