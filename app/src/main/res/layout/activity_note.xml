<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_premium"
    android:padding="18dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Bublu Notes"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        android:textSize="24sp" />

    <EditText
        android:id="@+id/noteTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:background="@drawable/card_glass"
        android:hint="Title"
        android:padding="14dp"
        android:singleLine="true"
        android:textColor="#FFFFFF"
        android:textColorHint="#9AA6D8"
        android:textSize="17sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/noteBody"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:layout_weight="1"
        android:background="@drawable/card_glass"
        android:gravity="top|start"
        android:hint="Write your notes here..."
        android:inputType="textMultiLine"
        android:padding="14dp"
        android:textColor="#FFFFFF"
        android:textColorHint="#9AA6D8"
        android:textSize="15sp" />

    <Button
        android:id="@+id/saveNote"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/btn_3d"
        android:text="Save note"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:textSize="17sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="8dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/deleteNote"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="@drawable/btn_glass"
            android:text="Delete"
            android:textAllCaps="false"
            android:textColor="#FFB4B4"
            android:textSize="15sp" />

        <Button
            android:id="@+id/closeNote"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginLeft="8dp"
            android:layout_weight="1"
            android:background="@drawable/btn_glass"
            android:text="Close"
            android:textAllCaps="false"
            android:textColor="#E9E3FF"
            android:textSize="15sp" />
    </LinearLayout>
</LinearLayout>
