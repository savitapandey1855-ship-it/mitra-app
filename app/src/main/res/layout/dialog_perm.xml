<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="18dp"
    android:background="@drawable/dialog_bg">

    <ImageView
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_gravity="center_horizontal"
        android:src="@drawable/char_happy"
        android:contentDescription="Bublu" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="6dp"
        android:text="Let's set up Bublu"
        android:textColor="#141B3D"
        android:textStyle="bold"
        android:textSize="18sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:lineSpacingExtra="5dp"
        android:text="Step 1  ·  Display over other apps\nSo Bublu can float on your screen. Tap Allow.\n\nStep 2  ·  Microphone\nSo Bublu can hear you. Tap Allow.\n\nStep 3  ·  Notifications\nFor reminders, alarms and group messages.\n\nStep 4  ·  Contacts &amp; Phone\nTo find and call people by name.\n\nStep 5  ·  Accessibility (in Settings)\nSo Bublu can open apps, tap buttons and type.\n\nStep 6  ·  Notification access\nOnly if you want Bublu to read your important groups."
        android:textColor="#2E3866"
        android:textSize="13sp" />

    <Button
        android:id="@+id/allowAll"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/btn_3d"
        android:text="Start setup"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textStyle="bold" />
</LinearLayout>
