<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="26dp"
    android:background="@drawable/bg_gradient">

    <ImageView
        android:layout_width="96dp"
        android:layout_height="96dp"
        android:src="@drawable/char_idle"
        android:contentDescription="@string/app_name" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Bublu"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        android:textSize="32sp" />

    <TextView
        android:id="@+id/statusTxt"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center"
        android:text="Band hai"
        android:textColor="#C9D4FF"
        android:textSize="15sp" />

    <Button
        android:id="@+id/toggleBtn"
        android:layout_width="match_parent"
        android:layout_height="58dp"
        android:layout_marginTop="22dp"
        android:background="@drawable/btn_bg"
        android:text="ON karo"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:textStyle="bold" />

    <Button
        android:id="@+id/permBtn"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/btn_soft"
        android:text="Permissions do"
        android:textAllCaps="false"
        android:textColor="#E7ECFF"
        android:textSize="15sp" />

    <Button
        android:id="@+id/accBtn"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/btn_soft"
        android:text="Click/Type permission"
        android:textAllCaps="false"
        android:textColor="#E7ECFF"
        android:textSize="15sp" />

    <Button
        android:id="@+id/autoBtn"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/btn_soft"
        android:text="Autostart ON karo"
        android:textAllCaps="false"
        android:textColor="#E7ECFF"
        android:textSize="15sp" />

    <Button
        android:id="@+id/keyBtn"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/btn_soft"
        android:text="Gemini key"
        android:textAllCaps="false"
        android:textColor="#E7ECFF"
        android:textSize="15sp" />

    <Button
        android:id="@+id/testBtn"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/btn_soft"
        android:text="Test AI"
        android:textAllCaps="false"
        android:textColor="#E7ECFF"
        android:textSize="15sp" />

</LinearLayout>
