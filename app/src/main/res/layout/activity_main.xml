<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="28dp"
    android:background="@drawable/bg_gradient">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="&#128512;"
        android:textSize="76sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="Mitra"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        android:textSize="34sp" />

    <TextView
        android:id="@+id/statusTxt"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center"
        android:text="Band hai"
        android:textColor="#C9D4FF"
        android:textSize="15sp" />

    <Button
        android:id="@+id/toggleBtn"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_marginTop="26dp"
        android:background="@drawable/btn_bg"
        android:text="ON karo"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:textStyle="bold" />

    <Button
        android:id="@+id/permBtn"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="14dp"
        android:background="@drawable/btn_soft"
        android:text="Permissions do &#10024;"
        android:textAllCaps="false"
        android:textColor="#E7ECFF"
        android:textSize="15sp" />

    <Button
        android:id="@+id/keyBtn"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/btn_soft"
        android:text="Gemini key &#128273;"
        android:textAllCaps="false"
        android:textColor="#E7ECFF"
        android:textSize="15sp" />

    <Button
        android:id="@+id/testBtn"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/btn_soft"
        android:text="Test AI &#9989;"
        android:textAllCaps="false"
        android:textColor="#E7ECFF"
        android:textSize="15sp" />

</LinearLayout>
